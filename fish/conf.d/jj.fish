#!/usr/bin/env fish

# Oh-My-Zsh jj plugin abbreviations.
# Source: https://github.com/ohmyzsh/ohmyzsh/blob/master/plugins/jj/jj.plugin.zsh

abbr -a jja -- 'jj abandon'

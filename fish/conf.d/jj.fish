abbr -a jjbm -- 'jj bookmark move'
abbr -a jjbr -- 'jj bookmark rename'
abbr -a jjbs -- 'jj bookmark set'
abbr -a jjbt -- 'jj bookmark track'
abbr -a jjbu -- 'jj bookmark untrack'
abbr -a jjc -- 'jj commit'
